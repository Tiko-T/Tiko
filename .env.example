APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tiko?schema=public
SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_TTL_DAYS=14
BETA_INVITE_TTL_HOURS=72
CRON_SECRET=replace-with-a-long-random-secret

# Optional one-time admin seeding for the first hosted beta admin.
BETA_ADMIN_EMAIL=admin@example.com
BETA_ADMIN_PASSWORD=replace-with-a-strong-password
BETA_ADMIN_NAME=Tiko Admin

PAYMENT_PROVIDER_MODE=ckb
PAYMENT_CONFIRMATIONS_REQUIRED=1
CKB_NETWORK=testnet
CKB_RPC_URL=https://testnet.ckb.dev/rpc
CKB_TOKEN_SYMBOL=tTIKO
CKB_TOKEN_DECIMALS=2
CKB_ISSUER_ADDRESS=
CKB_ISSUER_PRIVATE_KEY=
CKB_SPORE_MINTER_PRIVATE_KEY=
PAYMENT_RECEIVER_ADDRESS=
CKB_XUDT_ARGS=
SPORE_MINTING_MODE=real

# Hosted media uploads on Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Local devnet-only helpers. Leave unset for hosted beta.
CKB_MERCHANT_PRIVATE_KEY=
CKB_TEST_BUYER_PRIVATE_KEY=
